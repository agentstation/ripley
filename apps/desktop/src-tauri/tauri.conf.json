{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ripley",
  "version": "0.1.0",
  "identifier": "io.ripley.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ripley",
        "width": 900,
        "height": 600,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ripley-script-shell"],
    "category": "DeveloperTool",
    "shortDescription": "Supply chain defense for developers",
    "longDescription": "Supply chain defense for developers. System tray app + package manager guard."
  }
}
